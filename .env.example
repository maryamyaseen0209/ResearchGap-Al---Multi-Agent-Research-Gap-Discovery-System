# Copy this file to .env. Never commit actual credentials.
# =====================================================================
# RESEARCHGAP AI — MODEL PROVIDER CONFIGURATION
# =====================================================================
# Strategy:
# 1. Primary: Gemini API keys (rotates Key 1 -> Key 2 -> Key 3 on rate limits)
# 2. Failover: Groq API keys (automatically shifts to Groq when Gemini limits are reached)
#
# You can provide keys either as a comma-separated list OR as individual numbered variables.

# --- 1. GEMINI API KEYS (PRIMARY: 3 KEYS) ---
# Comma-separated:
GEMINI_API_KEYS=
# Or individually:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# --- 2. GROQ API KEYS (FAILOVER: 3 KEYS) ---
# Comma-separated:
GROQ_API_KEYS=
# Or individually:
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- 3. OPENALEX API KEY (SCHOLARLY LITERATURE METADATA) ---
# OpenAlex works without a key for small demos, but the free key raises budgets.
# Create a key at https://openalex.org/settings/api and keep it secret.
OPENALEX_API_KEY=
